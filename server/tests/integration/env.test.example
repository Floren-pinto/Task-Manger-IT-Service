# Salin ke server/.env.test (sudah di-ignore git) lalu isi dengan project
# Supabase KHUSUS TEST. Jangan pakai project production: test membuat dan
# mengubah data. Panduan lengkap: docs/testing.md

# Konfirmasi eksplisit bahwa project di bawah adalah project test.
TEST_TARGET_IS_TEST_PROJECT=yes

SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
# Opsional: dibutuhkan skenario akun nonaktif (POST /api/users).
SUPABASE_SERVICE_ROLE_KEY=

# Satu akun aktif per role. TECHNICIAN wajib punya divisi; MANAGER_DIVISION
# sebaiknya di divisi yang sama agar test notifikasi status ikut berjalan.
TEST_SUPER_ADMIN_EMAIL=
TEST_SUPER_ADMIN_PASSWORD=
TEST_MANAGER_DIVISION_EMAIL=
TEST_MANAGER_DIVISION_PASSWORD=
TEST_STAFF_EMAIL=
TEST_STAFF_PASSWORD=
TEST_TECHNICIAN_EMAIL=
TEST_TECHNICIAN_PASSWORD=

# Domain email untuk akun sementara di skenario akun nonaktif.
TEST_EMAIL_DOMAIN=example.com
